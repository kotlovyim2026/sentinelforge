# SentinelForge Environment Configuration
# Copy this file to .env and update with your actual values

# ==================== Database ====================
DATABASE_URL="postgresql://user:password@localhost:5432/sentinelforge?schema=public"

# ==================== Gateway (sf-gateway) ====================
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET="change-this-to-a-long-random-string-in-production"
COOKIE_DOMAIN=""  # Leave empty for localhost, set to your domain in production

# CORS
WEB_ORIGIN="http://localhost:3000"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ==================== Web App (sf-web) ====================
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ==================== AI Service (sf-ai) ====================
# Add AI service config when implementing

# ==================== Orchestrator (sf-orchestrator) ====================
# Add orchestrator config when implementing

# ==================== Integrations (sf-integrations) ====================
# Add integration service config when implementing
